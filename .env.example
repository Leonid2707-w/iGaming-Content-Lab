# Public site (production domain, no trailing slash)
PUBLIC_SITE_URL=https://igamingcontentlab.pro
# Extra CORS origins (comma-separated), localhost always allowed
ALLOWED_ORIGINS=https://www.igamingcontentlab.pro

# API
PORT=8787
# Owner login is always seeded as `leonid` (Super Admin). Password is hashed in DB.
# ADMIN_LOGIN is legacy fallback only if migration 007 is not applied yet.
ADMIN_LOGIN=leonid
ADMIN_PASSWORD=
# Long random secret (≥24 chars). Never commit real values.
ADMIN_API_SECRET=

# Telegram Bot API (обязательно для уведомлений о заказах)
# 1) TELEGRAM_BOT_TOKEN — токен от @BotFather (НЕ публикуйте его)
# 2) TELEGRAM_ADMIN_ID — chat_id группы/канала/личного чата, например -1002540854424
#    Бот должен быть добавлен в чат (для канала — админ с правом писать)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Необязательно: свой шаблон сообщения (HTML). Перенос строки: \n
# Доступные переменные:
# {public_id} {date} {telegram} {service} {platform} {quantity}
# {price} {price_label} {status} {description} {references}
# {links} {files_count} {files_note} {user_id}
# TELEGRAM_ORDER_TEMPLATE=🆕 <b>Новая заявка iCL</b>\nID: <code>{public_id}</code>\n👤 {telegram}\n🛠 {service}\n💰 {price_label}\n⏱️ {date}

# Google Sheets order sync (Apps Script Web App)
# See google-apps-script/OrderSheetSync.gs
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Supabase (API server only — NEVER put service_role in VITE_*)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel: set the same vars above in Project → Settings → Environment Variables
# Do NOT set VITE_API_URL (browser must call same-origin /api)
# See DEPLOY.md for Supabase migrations and smoke checks.
